@startuml
skinparam packageStyle rectangle

left to right direction

actor Recruiter
actor Candidate
actor "Hiring Committee" as Committee

package "Hiring Process" {
    (Create Job Description) as CreateJob
    (Generate Shareable Link) as ShareLink
    (Apply for Job) as Apply
    (Upload Documents) as Upload
    (Evaluate Candidates) as Evaluate
    (Reject Candidate) as Reject
    (Send Rejection Email) as SendEmail
    (Interview Candidate) as Interview
    (Make Hiring Decision) as Decide
    (Generate Analytical Report) as Report
}

Recruiter --> CreateJob
Recruiter --> Report

Candidate --> Apply

Committee --> Evaluate
Committee --> Reject
Committee --> Interview
Committee --> Decide
Apply ..> Upload : <<include>>
Reject ..> SendEmail : <<include>>
ShareLink ..> CreateJob : <<extend>>

@enduml